[gd_scene load_steps=9 format=3]

[ext_resource type="Script" path="res://scripts/main.gd" id="1_rhi7x"]
[ext_resource type="PackedScene" path="res://scenes/player.tscn" id="2_h0b1r"]
[ext_resource type="Script" path="res://scripts/arena.gd" id="3_arena"]
[ext_resource type="Script" path="res://scripts/camera_rig.gd" id="4_camrig"]
[ext_resource type="PackedScene" path="res://scenes/fx/retro_post.tscn" id="5_retropost"]
[ext_resource type="PackedScene" path="res://scenes/fx/impact_frame.tscn" id="6_impactframe"]
[ext_resource type="Script" path="res://scripts/ui/hud.gd" id="7_hud"]

[sub_resource type="Environment" id="Environment_arena"]
background_mode = 1
background_color = Color(0.960784, 0.925490, 0.847059, 1)
ambient_light_source = 1
tonemap_mode = 0

; ⚠️ LA PAUSE EST CELLE DU MOTEUR (`get_tree().paused`), ET ELLE SE REGLE ICI.
;
; `Main` est en PROCESS_MODE_ALWAYS : sans ca, Échap ne rouvrirait plus rien une
; fois le jeu en pause et les cartons ne s'animeraient plus. Mais un mode
; explicite se PROPAGE — tout enfant en "Inherit" hériterait de ALWAYS, et plus
; rien ne se mettrait en pause.
;
; D'où la règle, et elle est complète : ce qui est LE MONDE est explicitement
; PROCESS_MODE_PAUSABLE (= 1). `HudLayer`, `RetroPost` et `WorldEnvironment`
; restent en Inherit, donc ALWAYS — l'interface doit vivre pendant la pause, et
; les deux autres ne calculent rien.
;
; Ajouter un node de gameplay sous `Main` sans lui poser `process_mode = 1`,
; c'est le faire tourner derrière les cartons. Le défaut est silencieux : une
; griffure qui avance ses poses derrière un panneau se libère sans avoir
; distribué ses dégâts, et rien à l'écran ne le dit.
[node name="Main" type="Node3D"]
process_mode = 3
script = ExtResource("1_rhi7x")

[node name="WorldEnvironment" type="WorldEnvironment" parent="."]
environment = SubResource("Environment_arena")

[node name="Arena" type="Node3D" parent="."]
process_mode = 1
script = ExtResource("3_arena")

[node name="Enemies" type="Node3D" parent="."]
process_mode = 1

[node name="Projectiles" type="Node3D" parent="."]
process_mode = 1

[node name="Pickups" type="Node3D" parent="."]
process_mode = 1

[node name="Fx" type="Node3D" parent="."]
process_mode = 1

[node name="Player" parent="." instance=ExtResource("2_h0b1r")]
process_mode = 1

[node name="CameraRig" type="Node3D" parent="."]
process_mode = 1
physics_interpolation_mode = 2
script = ExtResource("4_camrig")

[node name="Camera3D" type="Camera3D" parent="CameraRig"]
transform = Transform3D(1, 0, 0, 0, 0.719226, -0.694776, 0, 0.694776, 0.719226, 0, 26.8701, 26.8701)
fov = 24.0
near = 1.0
far = 400.0

; L'interface est en layer -2, donc SOUS l'impact frame (-1) et SOUS le
; post-process retro (0). C'est deliberé : le HUD fait partie de l'IMAGE, il
; doit donc recevoir le grain de §8bis comme le reste. Pose
; au-dessus, il se lirait comme un calque d'UI colle sur le film — exactement
; l'argument que porte deja l'impact frame.
[node name="HudLayer" type="CanvasLayer" parent="."]
layer = -2

[node name="Hud" type="Control" parent="HudLayer"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("7_hud")

[node name="ImpactFrame" parent="." instance=ExtResource("6_impactframe")]
process_mode = 1

[node name="RetroPost" parent="." instance=ExtResource("5_retropost")]
